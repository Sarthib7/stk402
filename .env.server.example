STK402_NETWORK=sepolia
STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
STRK20_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
STRK20_INDEXER_URL=https://discovery-service.alpha-sepolia.sw-dev.io

STK402_RECIPIENT_ADDRESS=replace_me
STK402_RECIPIENT_VIEWING_KEY=replace_me
STK402_PAYMENT_TOKEN=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
STK402_PAYMENT_AMOUNT=1
# Base64url X25519 DER keys. Keep the private key only on the server.
STK402_ENVELOPE_PRIVATE_KEY=replace_me
STK402_ENVELOPE_PUBLIC_KEY=replace_me
# Pin the authorized payer's base64url X25519 SPKI public key.
STK402_AUTHORIZED_CLIENT_ENVELOPE_PUBLIC_KEY=replace_me
STK402_INVOICE_TIMEOUT_SECONDS=900
# Mount this path on persistent storage in production.
STK402_LEDGER_PATH=./data/claims.sqlite
STK402_PUBLIC_ORIGIN=https://replace_me.example
# Local default 127.0.0.1. On Render, omit STK402_HOST (binds 0.0.0.0 when PORT is set) or set STK402_HOST=0.0.0.0.
STK402_HOST=127.0.0.1
# Local port. Render injects PORT and the server prefers it.
STK402_PORT=3402
