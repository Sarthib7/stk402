STK402_NETWORK=sepolia
STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
STRK20_POOL_ADDRESS=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
STRK20_INDEXER_URL=https://discovery-service.alpha-sepolia.sw-dev.io
STRK20_PROVING_SERVICE_URL=https://transaction-prover.alpha-sepolia.sw-dev.io

STK402_RESOURCE_URL=https://replace_me.example/tools/sha256?text=stk402
STK402_PAYER_ADDRESS=replace_me
STK402_PAYER_PRIVATE_KEY=replace_me
STK402_PAYER_VIEWING_KEY=replace_me
STK402_EXPECTED_RECIPIENT=replace_me
# Pin the server's base64url X25519 SPKI public key.
STK402_ENVELOPE_PUBLIC_KEY=replace_me
# Keep the client private key only on the payer.
STK402_CLIENT_ENVELOPE_PRIVATE_KEY=replace_me
STK402_CLIENT_ENVELOPE_PUBLIC_KEY=replace_me

# Values use FRI, the smallest STRK unit.
STK402_MAX_PAYMENT_AMOUNT=replace_me
STK402_MAX_POOL_FEE=replace_me
STK402_MAX_NETWORK_FEE=replace_me
STK402_DAILY_SPEND_LIMIT=replace_me

# Required only by npm run fund:payer. Change the ID for each intended deposit.
STK402_PRIVATE_FUNDING_ID=initial-sepolia-funding
STK402_PRIVATE_FUND_AMOUNT=replace_me
STK402_FUND_MIN_PROOF_VALIDITY_BLOCKS=10

# Mount this path on persistent storage in production.
STK402_PAYER_STATE_PATH=./data/payer.sqlite
STK402_PROVER_TIMEOUT_MS=600000
STK402_MIN_INVOICE_VALIDITY_MS=360000
STK402_ALLOWED_CLOCK_SKEW_MS=30000
